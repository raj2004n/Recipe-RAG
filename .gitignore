# .gitignore

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
eggs/
*.egg
.env
venv/
env/
.venv

# Web Crawler
recipe_crawler/**/__pycache__/
recipe_crawler/*.log
recipe_crawler/crawled_data/
recipe_crawler/.scrapy/
*.pyc

# Data files (tracked by DVC, not Git)
data/raw/*.csv
data/raw/*.json
data/processed/*.csv
data/processed/*.json
!data/raw/.gitkeep
!data/processed/.gitkeep

# Eval-data working files (regenerated by the prompts / answers drafters).
# Tracked via DVC once the canonical prompts.jsonl + golden.jsonl are ready.
data/eval/

# Pair-building, distillation and training working files. The artifacts that
# are costly to rebuild are DVC-tracked, so the .dvc pointers stay in git, the
# run manifests stay in git (negated after the blanket *.json rule below), and
# the data itself does not.
data/pairs/*
!data/pairs/*.dvc
!data/pairs/.gitignore

# Model files (tracked by DVC, not Git)
models/*.bin
models/*.pkl
models/*.pt
models/*.h5
models/*.safetensors
models/embedding_model/
!models/.gitkeep

# MLflow
mlruns/
mlflow.db

# Jupyter Notebooks
.ipynb_checkpoints/
*.ipynb_checkpoints

# Notebook experiments are personal working files rather than project source.
# Files already tracked under here stay tracked; this only keeps new ones out.
notebook/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
.directory

# Claude Code / agent harness state (per-user, not project source)
.agents/
.claude/
CLAUDE.md

# Lavish skill output (generated artifacts)
.lavish/

# Temp working/output directory (build artifacts, debug configs, indices)
temp/

# Docker build context: staged model weights (regenerated by scripts/stage_weights.sh)
.docker/weights/

# DVC
.dvc/tmp/
.dvc/cache/
*.dvc.tmp

# Logs
*.log
logs/

*.json

# The rule above ignores every JSON in the tree. The pair-building and
# distillation run manifests are the provenance record for their artifacts, so
# they are the exception. The negation has to sit after the blanket rule
# because the last matching pattern wins.
!data/pairs/*_manifest.json

# The smoke and probe manifests describe reads of a prompt that never became
# the real set, so they stay working files beside their labels.
data/pairs/*_smoke_manifest.json
data/pairs/*_probe_manifest.json

# Generated dataset-quality reports (regenerated on every CLI run; the root
# *.json rule also catches these, but the explicit line is defence-in-depth).
data/eval/.quality_report.json

#MlFlow
mlruns/
mlartifacts/

# Student adapters and their run manifests, written by src/rag/training/student.py.
# The weights stay out of git and the DVC pointer stays in, so the directory itself
# is not excluded: git will not descend into an excluded directory, which would hide
# the pointer beneath it. The directories are re-included so git walks down, then the
# pointer, and the .gitignore dvc writes beside it when it needs one.
artifacts/**/*
!artifacts/**/
!artifacts/**/*.dvc
!artifacts/**/.gitignore

# DVC auto-manages the contents of snapshots/ via dvc add. Each versioned
# snapshot folder gets added to .gitignore by dvc; the .dvc pointer files
# (created alongside the snapshots) are git-tracked.
snapshots/registry.json
