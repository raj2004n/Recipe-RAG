# .gitignore

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
eggs/
*.egg
.env
venv/
env/
.venv

# Web Crawler
recipe_crawler/**/__pycache__/
recipe_crawler/*.log
recipe_crawler/crawled_data/
recipe_crawler/.scrapy/
*.pyc

# Data files (tracked by DVC, not Git)
data/raw/*.csv
data/raw/*.json
data/processed/*.csv
data/processed/*.json
!data/raw/.gitkeep
!data/processed/.gitkeep

# Model files (tracked by DVC, not Git)
models/*.bin
models/*.pkl
models/*.pt
models/*.h5
models/*.safetensors
models/embedding_model/
!models/.gitkeep

# MLflow
mlruns/
mlflow.db

# Jupyter Notebooks
.ipynb_checkpoints/
*.ipynb_checkpoints

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
.directory

# Claude Code / agent harness state (per-user, not project source)
.agents/
.claude/
CLAUDE.md

# Lavish skill output (generated artifacts)
.lavish/

# Temp working/output directory (build artifacts, debug configs, indices)
temp/

# DVC
.dvc/tmp/
.dvc/cache/
*.dvc.tmp

# Logs
*.log
logs/

*.json

#MlFlow
mlruns/
mlartifacts/
# DVC auto-manages the contents of snapshots/ via dvc add. Each versioned
# snapshot folder gets added to .gitignore by dvc; the .dvc pointer files
# (created alongside the snapshots) are git-tracked.
snapshots/registry.json
